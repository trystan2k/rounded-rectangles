{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "zai-coding-plan/glm-5.3-flash",
  "mcp": {
    "mcp_engram": {
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true,
      "type": "local"
    },
    "mcp_serena": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--enable-web-dashboard",
        "false",
        "--project",
        "rounded-rectangles",
        "--mode",
        "interactive",
        "--mode",
        "editing",
        "--mode",
        "no-memories"
      ]
    }
  }
}
